# Same MongoDB connection string as packages/db (used by better-auth + Prisma)
CLUSTER_URL=mongodb://localhost:27017/ecommerce?replicaSet=rs0

# URL of this admin app
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Backend REST API the admin talks to (see README "API contract")
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
