{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "ecommerce-admin-template/apps/admin",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "morellafrontend",
          "format": "url",
          "env": "FRONTEND_URL"
        }
      ]
    },
    "morellafrontend": {
      "root": "Morella frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "admin",
          "format": "url",
          "env": "ADMIN_SERVICE_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "morellafrontend"
      }
    }
  ]
}
